---
interface Row {
  input: number;
  output: string;
}

interface Props {
  fromSymbol: string;
  toSymbol: string;
  rows: Row[];
}

const { fromSymbol, toSymbol, rows } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-slate-200">
  <table class="w-full text-left text-sm">
    <thead class="bg-slate-100 text-slate-600">
      <tr>
        <th class="px-4 py-3 font-medium">{fromSymbol}</th>
        <th class="px-4 py-3 font-medium">{toSymbol}</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 bg-white">
      {rows.map((row) => (
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-2.5 font-medium text-slate-900">{row.input}</td>
          <td class="px-4 py-2.5 text-slate-700">{row.output}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
