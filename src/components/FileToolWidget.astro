---
import type { FileTool } from '../lib/tools';

interface Props {
  tool: FileTool;
}

const { tool } = Astro.props;
---

<div
  class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
  data-file-tool={tool.slug}
  data-accept={tool.accept}
  data-output-ext={tool.outputExt}
>
  <div
    data-dropzone
    class="flex cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition hover:border-blue-400 hover:bg-blue-50/40"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      class="mb-3 h-10 w-10 text-slate-400"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"
      ></path>
    </svg>
    <p class="text-base font-medium text-slate-800">
      Drop your <span class="text-blue-600">{tool.acceptLabel}</span> file here
    </p>
    <p class="mt-1 text-sm text-slate-500">or click to browse · max 10 MB</p>
    <input
      type="file"
      accept={tool.accept}
      class="sr-only"
      data-file-input
      aria-label={`Select ${tool.acceptLabel} file`}
    />
  </div>

  <div data-file-meta class="mt-4 hidden rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
    <span data-file-name class="font-medium"></span>
    <span data-file-size class="ml-2 text-slate-500"></span>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <button
      type="button"
      data-convert-btn
      disabled
      class="rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-slate-300"
    >
      Convert to {tool.outputExt.toUpperCase()}
    </button>
    <button
      type="button"
      data-clear-btn
      class="hidden rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-400 hover:bg-slate-50"
    >
      Clear
    </button>
  </div>

  <p data-status class="mt-4 hidden text-sm" role="status" aria-live="polite"></p>
  <ul data-warnings class="mt-3 hidden list-disc space-y-1 pl-5 text-sm text-amber-700"></ul>
</div>

<script>
  import { MAX_FILE_BYTES } from '../lib/tools';
  import { downloadBlob, formatFileSize, outputNameFromInput } from '../lib/download';

  function initTool(root: HTMLElement) {
    const slug = root.dataset.fileTool;
    const outputExt = root.dataset.outputExt ?? 'bin';
    const dropzone = root.querySelector<HTMLElement>('[data-dropzone]')!;
    const input = root.querySelector<HTMLInputElement>('[data-file-input]')!;
    const meta = root.querySelector<HTMLElement>('[data-file-meta]')!;
    const fileNameEl = root.querySelector<HTMLElement>('[data-file-name]')!;
    const fileSizeEl = root.querySelector<HTMLElement>('[data-file-size]')!;
    const convertBtn = root.querySelector<HTMLButtonElement>('[data-convert-btn]')!;
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-clear-btn]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const warningsEl = root.querySelector<HTMLElement>('[data-warnings]')!;

    let selectedFile: File | null = null;

    function setStatus(message: string, type: 'info' | 'error' | 'success' = 'info') {
      status.textContent = message;
      status.classList.remove('hidden', 'text-slate-600', 'text-red-600', 'text-emerald-700');
      if (type === 'error') status.classList.add('text-red-600');
      else if (type === 'success') status.classList.add('text-emerald-700');
      else status.classList.add('text-slate-600');
    }

    function clearWarnings() {
      warningsEl.innerHTML = '';
      warningsEl.classList.add('hidden');
    }

    function showWarnings(items: string[]) {
      if (items.length === 0) return;
      warningsEl.innerHTML = items.map((w) => `<li>${w}</li>`).join('');
      warningsEl.classList.remove('hidden');
    }

    function reset() {
      selectedFile = null;
      input.value = '';
      meta.classList.add('hidden');
      clearBtn.classList.add('hidden');
      convertBtn.disabled = true;
      status.classList.add('hidden');
      clearWarnings();
    }

    function pickFile(file: File | null) {
      reset();
      if (!file) return;

      if (file.size > MAX_FILE_BYTES) {
        setStatus(`File is too large (${formatFileSize(file.size)}). Maximum is 10 MB.`, 'error');
        return;
      }

      selectedFile = file;
      fileNameEl.textContent = file.name;
      fileSizeEl.textContent = `(${formatFileSize(file.size)})`;
      meta.classList.remove('hidden');
      clearBtn.classList.remove('hidden');
      convertBtn.disabled = false;
      setStatus('Ready to convert.', 'info');
    }

    dropzone.addEventListener('click', () => input.click());
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-blue-400', 'bg-blue-50/40');
    });
    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-blue-400', 'bg-blue-50/40');
    });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-blue-400', 'bg-blue-50/40');
      pickFile(e.dataTransfer?.files?.[0] ?? null);
    });
    input.addEventListener('change', () => pickFile(input.files?.[0] ?? null));
    clearBtn.addEventListener('click', reset);

    convertBtn.addEventListener('click', async () => {
      if (!selectedFile) return;
      clearWarnings();
      convertBtn.disabled = true;
      clearBtn.disabled = true;
      setStatus('Converting… this may take a few seconds.', 'info');

      try {
        const buffer = await selectedFile.arrayBuffer();
        const outName = outputNameFromInput(selectedFile.name, outputExt);

        if (slug === 'word-to-pdf') {
          const { convertWordToPdf } = await import('../lib/word-to-pdf');
          const { blob, warnings } = await convertWordToPdf(buffer);
          downloadBlob(blob, outName);
          showWarnings(warnings);
          setStatus(`Downloaded ${outName}.`, 'success');
        } else if (slug === 'pdf-to-word') {
          const { convertPdfToWord } = await import('../lib/pdf-to-word');
          const blob = await convertPdfToWord(buffer);
          downloadBlob(blob, outName);
          setStatus(`Downloaded ${outName}.`, 'success');
        } else {
          throw new Error('Unknown tool');
        }
      } catch (err) {
        const message = err instanceof Error ? err.message : 'Conversion failed.';
        setStatus(message, 'error');
      } finally {
        convertBtn.disabled = false;
        clearBtn.disabled = false;
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-file-tool]').forEach(initTool);
</script>
