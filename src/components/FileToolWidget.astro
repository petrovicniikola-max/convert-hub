---
import type { FileTool } from '../lib/tools';

interface Props {
  tool: FileTool;
}

const { tool } = Astro.props;
---

<div
  class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
  data-file-tool={tool.slug}
  data-accept={tool.accept}
  data-output-ext={tool.outputExt}
>
  <fieldset class="mb-5 space-y-2 rounded-xl border border-slate-200 bg-slate-50 p-4" data-mode-fieldset>
    <legend class="px-1 text-sm font-semibold text-slate-800">Conversion mode</legend>
    <label class="flex cursor-pointer gap-3 rounded-lg border border-transparent p-2 hover:bg-white has-[:checked]:border-blue-200 has-[:checked]:bg-white">
      <input type="radio" name={`mode-${tool.slug}`} value="quality" data-mode-input class="mt-1" checked />
      <span>
        <span class="block text-sm font-medium text-slate-900">Best quality (recommended)</span>
        <span class="mt-0.5 block text-xs leading-relaxed text-slate-600" data-quality-desc>
          pdf2docx / LibreOffice on our server. File is encrypted in transit, converted in memory, and deleted immediately. Up to 25 MB.
        </span>
      </span>
    </label>
    <label class="flex cursor-pointer gap-3 rounded-lg border border-transparent p-2 hover:bg-white has-[:checked]:border-blue-200 has-[:checked]:bg-white">
      <input type="radio" name={`mode-${tool.slug}`} value="private" data-mode-input class="mt-1" />
      <span>
        <span class="block text-sm font-medium text-slate-900">Private (browser only)</span>
        <span class="mt-0.5 block text-xs leading-relaxed text-slate-600">
          LibreOffice runs locally — nothing uploaded. First visit downloads ~200 MB. Up to 10 MB.
        </span>
      </span>
    </label>
  </fieldset>

  <div
    data-dropzone
    class="flex cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition hover:border-blue-400 hover:bg-blue-50/40"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      class="mb-3 h-10 w-10 text-slate-400"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"
      ></path>
    </svg>
    <p class="text-base font-medium text-slate-800">
      Drop your <span class="text-blue-600">{tool.acceptLabel}</span> file here
    </p>
    <p class="mt-1 text-sm text-slate-500" data-size-hint>or click to browse</p>
    <input
      type="file"
      accept={tool.accept}
      class="sr-only"
      data-file-input
      aria-label={`Select ${tool.acceptLabel} file`}
    />
  </div>

  <div data-file-meta class="mt-4 hidden rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
    <span data-file-name class="font-medium"></span>
    <span data-file-size class="ml-2 text-slate-500"></span>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <button
      type="button"
      data-convert-btn
      disabled
      class="rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-slate-300"
    >
      Convert to {tool.outputExt.toUpperCase()}
    </button>
    <button
      type="button"
      data-clear-btn
      class="hidden rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-400 hover:bg-slate-50"
    >
      Clear
    </button>
  </div>

  <div data-progress-wrap class="mt-4 hidden">
    <div class="h-2 overflow-hidden rounded-full bg-slate-200">
      <div data-progress-bar class="h-full w-0 rounded-full bg-blue-600 transition-[width] duration-300"></div>
    </div>
    <p data-progress-label class="mt-2 text-xs text-slate-500"></p>
  </div>

  <p data-status class="mt-4 hidden text-sm" role="status" aria-live="polite"></p>
  <ul data-warnings class="mt-3 hidden list-disc space-y-1 pl-5 text-sm text-amber-700"></ul>
</div>

<script>
  import { downloadBlob, formatFileSize, outputNameFromInput } from '../lib/download';
  import {
    isQualityModeAvailable,
    maxBytesForMode,
    type ConversionMode,
  } from '../lib/conversion';
  import { convertDocumentFile } from '../lib/document-convert';
  import { isCrossOriginIsolated, setLibreOfficeProgressHandler } from '../lib/libreoffice';

  function initTool(root: HTMLElement) {
    const outputExt = (root.dataset.outputExt ?? 'bin') as 'pdf' | 'docx';
    const dropzone = root.querySelector<HTMLElement>('[data-dropzone]')!;
    const input = root.querySelector<HTMLInputElement>('[data-file-input]')!;
    const meta = root.querySelector<HTMLElement>('[data-file-meta]')!;
    const fileNameEl = root.querySelector<HTMLElement>('[data-file-name]')!;
    const fileSizeEl = root.querySelector<HTMLElement>('[data-file-size]')!;
    const convertBtn = root.querySelector<HTMLButtonElement>('[data-convert-btn]')!;
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-clear-btn]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const warningsEl = root.querySelector<HTMLElement>('[data-warnings]')!;
    const progressWrap = root.querySelector<HTMLElement>('[data-progress-wrap]')!;
    const progressBar = root.querySelector<HTMLElement>('[data-progress-bar]')!;
    const progressLabel = root.querySelector<HTMLElement>('[data-progress-label]')!;
    const sizeHint = root.querySelector<HTMLElement>('[data-size-hint]')!;
    const modeInputs = root.querySelectorAll<HTMLInputElement>('[data-mode-input]');
    const qualityDesc = root.querySelector<HTMLElement>('[data-quality-desc]')!;

    let selectedFile: File | null = null;
    let qualityAvailable = false;

    function getMode(): ConversionMode {
      const checked = root.querySelector<HTMLInputElement>('[data-mode-input]:checked');
      return checked?.value === 'private' ? 'private' : 'quality';
    }

    function updateSizeHint() {
      const mode = getMode();
      const max = maxBytesForMode(mode);
      sizeHint.textContent = `or click to browse · max ${formatFileSize(max)}`;
    }

    function setProgress(percent: number, message: string) {
      progressWrap.classList.remove('hidden');
      progressBar.style.width = `${Math.min(100, Math.max(0, percent))}%`;
      progressLabel.textContent = message;
    }

    function hideProgress() {
      progressWrap.classList.add('hidden');
      progressBar.style.width = '0%';
      progressLabel.textContent = '';
    }

    function setStatus(message: string, type: 'info' | 'error' | 'success' = 'info') {
      status.textContent = message;
      status.classList.remove('hidden', 'text-slate-600', 'text-red-600', 'text-emerald-700');
      if (type === 'error') status.classList.add('text-red-600');
      else if (type === 'success') status.classList.add('text-emerald-700');
      else status.classList.add('text-slate-600');
    }

    function clearWarnings() {
      warningsEl.innerHTML = '';
      warningsEl.classList.add('hidden');
    }

    function showWarnings(items: string[]) {
      if (items.length === 0) return;
      warningsEl.innerHTML = items.map((w) => `<li>${w}</li>`).join('');
      warningsEl.classList.remove('hidden');
    }

    function reset() {
      selectedFile = null;
      input.value = '';
      meta.classList.add('hidden');
      clearBtn.classList.add('hidden');
      convertBtn.disabled = true;
      status.classList.add('hidden');
      hideProgress();
      clearWarnings();
      setLibreOfficeProgressHandler(null);
    }

    function pickFile(file: File | null) {
      reset();
      if (!file) return;

      const mode = getMode();
      const max = maxBytesForMode(mode);
      if (file.size > max) {
        setStatus(`File is too large (${formatFileSize(file.size)}). Maximum is ${formatFileSize(max)}.`, 'error');
        return;
      }

      selectedFile = file;
      fileNameEl.textContent = file.name;
      fileSizeEl.textContent = `(${formatFileSize(file.size)})`;
      meta.classList.remove('hidden');
      clearBtn.classList.remove('hidden');
      convertBtn.disabled = false;
      setStatus('Ready to convert.', 'info');
    }

    async function setupModes() {
      qualityAvailable = await isQualityModeAvailable();
      const qualityInput = root.querySelector<HTMLInputElement>('[data-mode-input][value="quality"]')!;
      const privateInput = root.querySelector<HTMLInputElement>('[data-mode-input][value="private"]')!;

      if (!qualityAvailable) {
        qualityInput.disabled = true;
        qualityInput.checked = false;
        privateInput.checked = true;
        qualityDesc.textContent =
          'Server conversion is starting soon — use Private mode for now (browser-only LibreOffice).';
      }

      updateSizeHint();
    }

    modeInputs.forEach((input) => {
      input.addEventListener('change', () => {
        updateSizeHint();
        if (selectedFile && selectedFile.size > maxBytesForMode(getMode())) {
          setStatus('File exceeds the limit for this mode. Choose Best quality or use a smaller file.', 'error');
          convertBtn.disabled = true;
        } else if (selectedFile) {
          convertBtn.disabled = false;
        }
      });
    });

    dropzone.addEventListener('click', () => input.click());
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-blue-400', 'bg-blue-50/40');
    });
    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-blue-400', 'bg-blue-50/40');
    });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-blue-400', 'bg-blue-50/40');
      pickFile(e.dataTransfer?.files?.[0] ?? null);
    });
    input.addEventListener('change', () => pickFile(input.files?.[0] ?? null));
    clearBtn.addEventListener('click', reset);

    convertBtn.addEventListener('click', async () => {
      if (!selectedFile) return;

      const mode = getMode();
      if (mode === 'quality' && !qualityAvailable) {
        setStatus('Best quality mode is not available yet. Switch to Private mode or try again later.', 'error');
        return;
      }

      if (mode === 'private' && !isCrossOriginIsolated()) {
        setStatus(
          'Private mode needs a secure page context. Open /tools directly on convert-hub.net, or use Best quality mode.',
          'error',
        );
        return;
      }

      clearWarnings();
      convertBtn.disabled = true;
      clearBtn.disabled = true;
      setStatus(mode === 'quality' ? 'Uploading and converting…' : 'Preparing browser converter…', 'info');

      if (mode === 'private') {
        setLibreOfficeProgressHandler((progress) => {
          setProgress(progress.percent, progress.message);
          if (progress.percent < 100) setStatus(progress.message, 'info');
        });
      }

      try {
        const outName = outputNameFromInput(selectedFile.name, outputExt);
        const result = await convertDocumentFile(selectedFile, outputExt, mode);
        downloadBlob(result.blob, outName);
        showWarnings(result.warnings);
        const engineLabel = result.engine === 'server' ? 'Server engine' : 'Browser engine';
        setStatus(`Downloaded ${outName} (${engineLabel}).`, 'success');
      } catch (err) {
        const message = err instanceof Error ? err.message : 'Conversion failed.';
        setStatus(message, 'error');
      } finally {
        hideProgress();
        setLibreOfficeProgressHandler(null);
        convertBtn.disabled = false;
        clearBtn.disabled = false;
      }
    });

    void setupModes();
  }

  document.querySelectorAll<HTMLElement>('[data-file-tool]').forEach(initTool);
</script>
