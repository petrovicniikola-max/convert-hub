---
import '../styles/global.css';
import LangSwitcher from '../components/LangSwitcher.astro';
import en from '../i18n/ui/en.json';
import { absoluteUrl } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: object | object[];
}

const { title, description, path = '/', jsonLd } = Astro.props;
const canonical = absoluteUrl(path);
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="y5V1c3iPEGbSkRPtF0rYjDKs9XGTMmEXhWTHro-RTzs" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    {umamiWebsiteId && (
      <script defer src="https://cloud.umami.is/script.js" data-website-id={umamiWebsiteId} />
    )}
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-4">
        <a href="/" class="flex flex-col gap-0.5">
          <span class="text-lg font-semibold tracking-tight text-slate-900">{en.siteName}</span>
          <span class="text-xs text-slate-500">{en.tagline}</span>
        </a>
        <nav class="flex items-center gap-4">
          <a href="/guides" class="text-sm text-slate-600 hover:text-blue-600">Guides</a>
          <LangSwitcher />
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-8">
      <slot />
    </main>

    <footer class="mt-12 border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-3xl px-4 py-6 text-center text-sm text-slate-500">
        <p>{en.footer.privacy}</p>
        <p class="mt-2">
          <a href="/guides" class="text-blue-600 hover:underline">Conversion guides</a>
        </p>
        <p class="mt-1 text-xs text-slate-400">{en.footer.comingSoon}</p>
      </div>
    </footer>
  </body>
</html>
