---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConverterWidget from '../../components/ConverterWidget.astro';
import ConversionTable from '../../components/ConversionTable.astro';
import FAQ from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { getCategoryMeta } from '../../lib/categories';
import { buildPageContent } from '../../lib/page-content';
import { conversionPairs, getRelatedPairs } from '../../lib/pairs';
import { getUnitInfo } from '../../lib/convert';
import { buildTitle, jsonLdFaq, jsonLdWebApplication, absoluteUrl } from '../../lib/seo';

export function getStaticPaths() {
  return conversionPairs.map((pair) => ({
    params: { slug: pair.slug },
    props: { pair },
  }));
}

interface Props {
  pair: (typeof conversionPairs)[number];
}

const { pair } = Astro.props;
const content = buildPageContent(pair);
const category = getCategoryMeta(pair.category)!;
const from = getUnitInfo(pair.category, pair.from);
const to = getUnitInfo(pair.category, pair.to);
const related = getRelatedPairs(pair);

const title = buildTitle(content.pageTitle);
const jsonLd = [
  jsonLdWebApplication(content.pageTitle, content.description, absoluteUrl(content.path)),
  jsonLdFaq(content.faq),
];
---

<BaseLayout title={title} description={content.description} path={content.path} jsonLd={jsonLd}>
  <article>
    <nav class="mb-4 text-sm text-slate-500" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span class="mx-2">/</span>
      <a href={category.path} class="hover:text-blue-600">{category.label}</a>
      <span class="mx-2">/</span>
      <span class="text-slate-700">{content.breadcrumbLabel}</span>
    </nav>

    <header class="mb-8">
      <p class="mb-2 text-sm font-medium uppercase tracking-wide text-blue-600">{content.categoryLabel} converter</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{content.h1}</h1>
      <p class="mt-3 text-lg leading-relaxed text-slate-600">{content.lead}</p>
    </header>

    <ConverterWidget
      category={pair.category}
      fromUnit={pair.from}
      toUnit={pair.to}
      defaultValue={pair.defaultValue}
    />

    <section class="mt-10 max-w-none">
      <h2 class="text-xl font-semibold text-slate-900">{content.introTitle}</h2>
      {content.introParagraphs.map((paragraph) => (
        <p class="mt-3 leading-relaxed text-slate-600">{paragraph}</p>
      ))}
      <div class="my-4 rounded-xl border border-slate-200 bg-slate-100 px-4 py-3 font-mono text-sm text-slate-800">
        {content.formula}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="mb-4 text-xl font-semibold text-slate-900">{content.tableTitle}</h2>
      <ConversionTable fromSymbol={from.symbol} toSymbol={to.symbol} rows={content.tableRows} />
    </section>

    <section class="mt-10">
      <h2 class="mb-4 text-xl font-semibold text-slate-900">{content.reverseTableTitle}</h2>
      <p class="mb-4 text-sm text-slate-600">
        Or click the swap button in the converter to switch from {to.symbol} to {from.symbol}.
      </p>
      <ConversionTable fromSymbol={to.symbol} toSymbol={from.symbol} rows={content.reverseTableRows} />
    </section>

    <FAQ items={content.faq} />
    <RelatedLinks pairs={related} />
  </article>
</BaseLayout>
