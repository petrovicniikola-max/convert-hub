---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import FileToolWidget from '../../components/FileToolWidget.astro';
import FAQ from '../../components/FAQ.astro';
import { fileTools, getFileTool } from '../../lib/tools';
import { buildTitle, jsonLdFaq, jsonLdWebApplication, absoluteUrl } from '../../lib/seo';

export function getStaticPaths() {
  return fileTools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: (typeof fileTools)[number];
}

const { tool } = Astro.props;

const faqBySlug: Record<string, Array<{ question: string; answer: string }>> = {
  'word-to-pdf': [
    {
      question: 'Is my Word document uploaded to a server?',
      answer:
        'No. The entire conversion runs in your browser. Your DOCX file never leaves your device.',
    },
    {
      question: 'What file types are supported?',
      answer:
        'This tool accepts .docx files (Microsoft Word 2007 and later). Older .doc files are not supported.',
    },
    {
      question: 'Will formatting be preserved?',
      answer:
        'Basic text, headings, and paragraphs usually convert well. Complex layouts, custom fonts, and embedded objects may look different in the PDF.',
    },
    {
      question: 'Is there a file size limit?',
      answer: 'Yes — files up to 10 MB are supported for reasonable browser performance.',
    },
  ],
  'pdf-to-word': [
    {
      question: 'Is my PDF uploaded to a server?',
      answer:
        'No. Text is extracted and a Word file is built locally in your browser. Your PDF never leaves your device.',
    },
    {
      question: 'Will the Word file look exactly like the PDF?',
      answer:
        'No. This tool extracts text and creates a simple DOCX. Images, tables, columns, and precise layout are not recreated — use it for text-heavy documents.',
    },
    {
      question: 'Can it convert scanned PDFs?',
      answer:
        'Scanned PDFs are images of text, not selectable text. This tool cannot OCR scanned pages — only PDFs with embedded text work.',
    },
    {
      question: 'What is the maximum file size?',
      answer: 'Files up to 10 MB are supported.',
    },
  ],
};

const contentBySlug: Record<
  string,
  { h1: string; lead: string; introTitle: string; introParagraphs: string[] }
> = {
  'word-to-pdf': {
    h1: 'Word to PDF Converter',
    lead: 'Turn DOCX files into PDF instantly — free, no signup, and 100% private.',
    introTitle: 'How it works',
    introParagraphs: [
      'Select or drop a .docx file. ConvertHub reads it in your browser, renders the content, and generates a PDF you can download immediately.',
      'Because nothing is sent to our servers, this is a good choice for drafts, letters, and everyday documents you do not want to upload elsewhere.',
    ],
  },
  'pdf-to-word': {
    h1: 'PDF to Word Converter',
    lead: 'Extract text from PDF and download an editable DOCX — runs locally in your browser.',
    introTitle: 'How it works',
    introParagraphs: [
      'Upload a text-based PDF. ConvertHub extracts the text page by page and builds a Word document you can open in Microsoft Word, Google Docs, or LibreOffice.',
      'This is ideal when you need to edit plain text from a PDF. It does not recreate complex formatting, images, or scanned pages.',
    ],
  },
};

const content = contentBySlug[tool.slug];
const faq = faqBySlug[tool.slug];
const related = getFileTool(tool.relatedSlug)!;
const path = `/tools/${tool.slug}`;
const title = buildTitle(tool.title);
const jsonLd = [
  jsonLdWebApplication(tool.title, tool.description, absoluteUrl(path)),
  jsonLdFaq(faq),
];
---

<BaseLayout title={title} description={tool.description} path={path} jsonLd={jsonLd}>
  <article>
    <BackLink href="/tools" label="All tools" />

    <header class="mb-8">
      <p class="mb-2 text-sm font-medium uppercase tracking-wide text-blue-600">File converter</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{content.h1}</h1>
      <p class="mt-3 text-lg leading-relaxed text-slate-600">{content.lead}</p>
    </header>

    <FileToolWidget tool={tool} />

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-slate-900">{content.introTitle}</h2>
      {content.introParagraphs.map((p) => <p class="mt-3 leading-relaxed text-slate-600">{p}</p>)}
      <p class="mt-4 text-sm text-slate-600">
        Need the reverse?
        <a href={`/tools/${related.slug}`} class="font-medium text-blue-600 hover:underline">
          {related.title}
        </a>
      </p>
    </section>

    <FAQ items={faq} />
  </article>
</BaseLayout>
