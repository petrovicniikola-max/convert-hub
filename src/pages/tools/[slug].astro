---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import FileToolWidget from '../../components/FileToolWidget.astro';
import FAQ from '../../components/FAQ.astro';
import { fileTools, getFileTool } from '../../lib/tools';
import { buildTitle, jsonLdFaq, jsonLdWebApplication, absoluteUrl } from '../../lib/seo';

export function getStaticPaths() {
  return fileTools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: (typeof fileTools)[number];
}

const { tool } = Astro.props;

const faqBySlug: Record<string, Array<{ question: string; answer: string }>> = {
  'word-to-pdf': [
    {
      question: 'Which mode should I use?',
      answer:
        'Best quality (default) uses LibreOffice on our server — fastest and most accurate for complex documents. Private mode runs LibreOffice in your browser if you do not want any upload.',
    },
    {
      question: 'Is my file stored on your server?',
      answer:
        'No. In Best quality mode, your file is sent over HTTPS, converted in memory, and deleted immediately. We do not keep copies.',
    },
    {
      question: 'What file types are supported?',
      answer: '.doc, .docx, .odt, and .rtf files are supported.',
    },
    {
      question: 'Will formatting be preserved?',
      answer:
        'Yes. We use LibreOffice — the same engine used by governments and enterprises worldwide. Tables, images, headers, and page layout are preserved in both modes.',
    },
    {
      question: 'What is the file size limit?',
      answer: 'Best quality: up to 25 MB. Private (browser): up to 10 MB.',
    },
  ],
  'pdf-to-word': [
    {
      question: 'Which mode should I use?',
      answer:
        'Best quality (default) uses pdf2docx on our server — specialized for rebuilding PDF layout as editable Word. Private mode uses browser LibreOffice if you prefer zero upload.',
    },
    {
      question: 'Will the Word file keep the PDF layout?',
      answer:
        'Best quality mode is built for this: pdf2docx analyzes pages and recreates paragraphs, tables, images, and positioning in DOCX. Complex forms or scanned pages may still need manual cleanup.',
    },
    {
      question: 'Is my PDF stored after conversion?',
      answer:
        'Never. Server mode processes the file in a temporary folder that is wiped when the download starts. Private mode never uploads anything.',
    },
    {
      question: 'Can it convert scanned PDFs?',
      answer:
        'No. Scanned PDFs are images, not text. Neither mode includes OCR. Use a scanned-PDF OCR tool first, then convert here.',
    },
    {
      question: 'What is the file size limit?',
      answer: 'Best quality: up to 25 MB. Private (browser): up to 10 MB.',
    },
  ],
};

const contentBySlug: Record<
  string,
  { h1: string; lead: string; introTitle: string; introParagraphs: string[] }
> = {
  'word-to-pdf': {
    h1: 'Word to PDF Converter',
    lead: 'Professional Word to PDF conversion — layout, tables, and images preserved.',
    introTitle: 'How it works',
    introParagraphs: [
      'Choose Best quality for server-side LibreOffice conversion (recommended), or Private to run LibreOffice entirely in your browser.',
      'Unlike lightweight HTML converters, this keeps real document structure — the same reason teams use LibreOffice instead of copy-paste exports.',
    ],
  },
  'pdf-to-word': {
    h1: 'PDF to Word Converter',
    lead: 'Turn PDFs into editable Word files while keeping layout — powered by pdf2docx.',
    introTitle: 'How it works',
    introParagraphs: [
      'Best quality mode uses pdf2docx, a layout-aware engine that rebuilds your PDF as an editable DOCX with tables, images, and text positioning intact.',
      'Need zero upload? Switch to Private mode for browser-only LibreOffice conversion.',
    ],
  },
};

const content = contentBySlug[tool.slug];
const faq = faqBySlug[tool.slug];
const related = getFileTool(tool.relatedSlug)!;
const path = `/tools/${tool.slug}`;
const title = buildTitle(tool.title);
const jsonLd = [
  jsonLdWebApplication(tool.title, tool.description, absoluteUrl(path)),
  jsonLdFaq(faq),
];
---

<BaseLayout title={title} description={tool.description} path={path} jsonLd={jsonLd}>
  <article>
    <BackLink href="/tools" label="All tools" />

    <header class="mb-8">
      <p class="mb-2 text-sm font-medium uppercase tracking-wide text-blue-600">File converter</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{content.h1}</h1>
      <p class="mt-3 text-lg leading-relaxed text-slate-600">{content.lead}</p>
    </header>

    <FileToolWidget tool={tool} />

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-slate-900">{content.introTitle}</h2>
      {content.introParagraphs.map((p) => <p class="mt-3 leading-relaxed text-slate-600">{p}</p>)}
      <p class="mt-4 text-sm text-slate-600">
        Need the reverse?
        <a href={`/tools/${related.slug}`} class="font-medium text-blue-600 hover:underline">
          {related.title}
        </a>
      </p>
    </section>

    <FAQ items={faq} />
  </article>
</BaseLayout>
