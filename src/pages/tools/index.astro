---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import { fileTools } from '../../lib/tools';
import { buildTitle } from '../../lib/seo';

const title = buildTitle('File Converters');
const description =
  'Free Word to PDF and PDF to Word converters. Everything runs in your browser — no uploads, no accounts.';
const path = '/tools';
---

<BaseLayout title={title} description={description} path={path}>
  <BackLink href="/" label="Home" />

  <header class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">File converters</h1>
    <p class="mt-3 text-lg text-slate-600">
      Professional PDF ↔ Word conversion. Best quality mode uses pdf2docx and LibreOffice on our server (ephemeral, never stored). Private mode runs in your browser.
    </p>
  </header>

  <ul class="grid gap-4">
    {
      fileTools.map((tool) => (
        <li>
          <a
            href={`/tools/${tool.slug}`}
            class="block rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow-md"
          >
            <h2 class="text-lg font-semibold text-slate-900">{tool.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{tool.description}</p>
            <p class="mt-3 text-xs font-medium text-blue-600">Open converter →</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
