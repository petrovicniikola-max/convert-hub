---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guides } from '../../lib/guides';
import { buildTitle, jsonLdFaq } from '../../lib/seo';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: (typeof guides)[number];
}

const { guide } = Astro.props;
const path = `/guides/${guide.slug}`;
const title = buildTitle(guide.title);

const faqFromSections = guide.sections.slice(0, 3).map((s) => ({
  question: s.heading,
  answer: s.paragraphs.join(' '),
}));
const jsonLd = jsonLdFaq(faqFromSections);
---

<BaseLayout title={title} description={guide.description} path={path} jsonLd={jsonLd}>
  <article>
    <nav class="mb-4 text-sm text-slate-500" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/guides" class="hover:text-blue-600">Guides</a>
      <span class="mx-2">/</span>
      <span class="text-slate-700">{guide.title}</span>
    </nav>

    <header class="mb-8">
      <p class="mb-2 text-sm font-medium uppercase tracking-wide text-blue-600">Guide</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{guide.title}</h1>
      <p class="mt-3 text-lg leading-relaxed text-slate-600">{guide.description}</p>
      <p class="mt-2 text-sm text-slate-400">{guide.readMinutes} min read</p>
    </header>

    {
      guide.sections.map((section) => (
        <section class="mt-8 max-w-none">
          <h2 class="text-xl font-semibold text-slate-900">{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p class="mt-3 leading-relaxed text-slate-600">{p}</p>
          ))}
          {section.list && (
            <ul class="mt-3 list-disc space-y-1 pl-5 text-slate-600">
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    {
      guide.relatedConverters.length > 0 && (
        <section class="mt-10">
          <h2 class="mb-4 text-xl font-semibold text-slate-900">Related converters</h2>
          <ul class="grid gap-2 sm:grid-cols-2">
            {guide.relatedConverters.map((link) => (
              <li>
                <a
                  href={`/convert/${link.slug}`}
                  class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm transition hover:border-blue-300 hover:bg-blue-50/50"
                >
                  <span class="font-medium text-slate-800">{link.label}</span>
                  <span class="text-blue-600" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
